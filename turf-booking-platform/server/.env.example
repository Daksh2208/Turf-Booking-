PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# MongoDB Atlas connection string placeholder
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/turf_booking?retryWrites=true&w=majority

# JWT Authentication Secrets Template
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret

# Initial Admin Seed Credentials Template
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@turfbooking.com
ADMIN_PASSWORD=placeholder_admin_password

# Stripe Payment Configuration Template
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=inr
STRIPE_PAYMENT_ENABLED=false
